{
  "name": "@eyeauras/nexus-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Nexus Repository connection and discovery CLI",
  "type": "module",
  "bin": {
    "nexus-cli": "dist/src/bin.js"
  },
  "files": [
    "dist/src/**/*.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@eyeauras/cli-factory": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "msw": "^2.11.0"
  }
}
